# Minimal Makefile to compile rans_interface.cpp without full pip install
# Usage on FPGA: make

# Detect Python Include/Lib paths
PYTHON_INCLUDES := $(shell python3-config --includes)
PYTHON_EXT_SUFFIX := $(shell python3-config --extension-suffix)

# Compiler flags
CXX = g++
CXXFLAGS = -O3 -Wall -shared -std=c++14 -fPIC $(PYTHON_INCLUDES)

# PyBind11 - We try system installed first, then bundled
PYBIND11_INCLUDES := $(shell python3 -m pybind11 --includes 2>/dev/null)
ifeq ($(PYBIND11_INCLUDES),)
    # Fallback to local include directory if pybind11 command fails
    PYBIND11_INCLUDES = -I./include
endif

TARGET = ans$(PYTHON_EXT_SUFFIX)
SRC = rans_interface.cpp

all: $(TARGET)

$(TARGET): $(SRC)
	@echo "Compiling $(TARGET)..."
	$(CXX) $(CXXFLAGS) $(PYBIND11_INCLUDES) -I. $(SRC) -o $(TARGET)

clean:
	rm -f $(TARGET)
